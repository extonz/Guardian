<UserControl x:Class="Guardian.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="30">
            <StackPanel>
                <CheckBox IsChecked="{Binding Settings.StartOnBoot}" Content="Start Guardian when Windows starts" Margin="0,0,0,15" FontSize="14"/>
                <CheckBox IsChecked="{Binding Settings.NotificationsEnabled}" Content="Enable desktop notifications" Margin="0,0,0,25" FontSize="14"/>

                <TextBlock Text="Data Retention (Days)" Margin="0,0,0,5" FontSize="14" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Settings.DataRetentionDays}" Width="100" HorizontalAlignment="Left" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,30"/>

                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Width="150" Height="40" HorizontalAlignment="Left" Background="#007ACC" Foreground="White" BorderThickness="0"/>
                <TextBlock Text="{Binding SaveStatus}" Foreground="Green" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
