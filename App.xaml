<Application x:Class="Guardian.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#17211D"/>
  <SolidColorBrush x:Key="Muted" Color="#75817B"/>
  <SolidColorBrush x:Key="Accent" Color="#287A58"/>
  <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="14,9"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="#E7EEE9"/><Setter Property="Foreground" Value="#17211D"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DDE4DF"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Margin" Value="0,7,0,7"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="#27332D"/>
  </Style>
 </Application.Resources>
</Application>
