<Window x:Class="Guardian.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Guardian" Height="760" Width="1120" MinHeight="680" MinWidth="980"
 WindowStartupLocation="CenterScreen" Background="#F4F7F4" Foreground="#17211D"
 FontFamily="Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#FFFFFF" BorderBrush="#E4EAE5" BorderThickness="0,0,1,0" Padding="22">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="0,5,0,34">
      <Border Width="34" Height="34" Background="#287A58" CornerRadius="10" VerticalAlignment="Center">
       <TextBlock Text="G" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Guardian" FontWeight="Bold" FontSize="19"/><TextBlock Text="DIGITAL WELLBEING" FontSize="9" Foreground="#75817B" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
     </StackPanel>
     <Button Content="Overview" Click="Overview_Click" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="#E7F1EA"/>
     <Button Content="Focus sessions" Click="Focus_Click" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="Transparent"/>
     <Button Content="App blocking" Click="Blocking_Click" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="Transparent"/>
     <Button Content="Privacy &amp; data" Click="Privacy_Click" HorizontalContentAlignment="Left" Background="Transparent"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
     <Border Background="#F2F6F3" CornerRadius="12" Padding="13">
      <StackPanel><TextBlock Text="PRIVATE BY DESIGN" FontSize="10" FontWeight="Bold" Foreground="#287A58"/><TextBlock Text="Your activity stays on this PC. Guardian does not upload usage data." TextWrapping="Wrap" FontSize="11" Foreground="#75817B" Margin="0,7,0,0"/></StackPanel>
     </Border>
     <TextBlock Text="GUARDIAN 7.1 · WINDOWS" Foreground="#9AA49E" FontSize="9" Margin="2,17,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
   <Grid Margin="34,28,34,34">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,25">
     <TextBlock x:Name="PageEyebrow" Text="YOUR DAY, WITH INTENTION" Foreground="#287A58" FontSize="11" FontWeight="Bold"/>
     <TextBlock x:Name="PageTitle" Text="Overview" FontSize="30" FontWeight="Bold" Margin="0,6,0,5"/>
     <TextBlock x:Name="PageSubtitle" Text="A clear picture of where your attention goes." Foreground="#75817B" FontSize="13"/>
    </StackPanel>
    <Grid Grid.Row="1">
     <Grid x:Name="OverviewPanel">
      <StackPanel>
       <UniformGrid Columns="3" Margin="0,0,0,18">
        <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="FOREGROUND TIME TODAY" FontSize="10" FontWeight="Bold" Foreground="#75817B"/><TextBlock x:Name="UsageValue" Text="0m" FontSize="30" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="Time spent in active apps" FontSize="11" Foreground="#75817B"/></StackPanel></Border>
        <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="FOCUS TODAY" FontSize="10" FontWeight="Bold" Foreground="#75817B"/><TextBlock x:Name="FocusValue" Text="0m" FontSize="30" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="Recorded focus time" FontSize="11" Foreground="#75817B"/></StackPanel></Border>
        <Border Background="White" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="APPS TRACKED" FontSize="10" FontWeight="Bold" Foreground="#75817B"/><TextBlock x:Name="AppsValue" Text="0" FontSize="30" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="Unique apps today" FontSize="11" Foreground="#75817B"/></StackPanel></Border>
       </UniformGrid>
       <Border Background="White" CornerRadius="14" Padding="22" Margin="0,0,0,18">
        <StackPanel><DockPanel><TextBlock Text="Application activity" FontSize="17" FontWeight="Bold"/><TextBlock Text="TODAY" Foreground="#75817B" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Guardian records only the foreground application name and time; window titles are not saved." Foreground="#75817B" FontSize="11" Margin="0,5,0,16" TextWrapping="Wrap"/><ItemsControl x:Name="UsageList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Display}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/><ProgressBar Value="{Binding Percent}" Maximum="100" Height="4" Margin="0,4,0,0" Foreground="#287A58" Background="#E7EEE9" BorderThickness="0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoUsageText" Text="Your activity will appear here as you use your computer." Foreground="#75817B" Margin="0,4,0,0"/></StackPanel>
       </Border>
       <Border Background="#E7F1EA" CornerRadius="14" Padding="22"><DockPanel><StackPanel><TextBlock Text="Ready for a focused session?" FontSize="16" FontWeight="Bold"/><TextBlock Text="Take 25 minutes for one thing. No pressure, just a little structure." Foreground="#53685B" Margin="0,5,0,0" FontSize="12"/></StackPanel><Button Content="Start focus →" Click="StartFocus_Click" Background="#287A58" Foreground="White" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="20,0,0,0"/></DockPanel></Border>
       <TextBlock x:Name="PersistenceStatus" Text="All data is stored locally on this PC." Foreground="#75817B" FontSize="11" Margin="2,12,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
     <Grid x:Name="FocusPanel" Visibility="Collapsed">
      <StackPanel>
       <Border Background="White" CornerRadius="14" Padding="28" Margin="0,0,0,18"><StackPanel HorizontalAlignment="Center">
        <TextBlock Text="FOCUS TIMER" Foreground="#287A58" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
        <TextBlock x:Name="TimerText" Text="25:00" FontSize="72" FontWeight="Light" HorizontalAlignment="Center" Margin="0,18,0,10"/>
        <TextBlock x:Name="TimerStatus" Text="Ready when you are." Foreground="#75817B" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="Session length" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="DurationBox" Width="100" SelectedIndex="1" Padding="7"><ComboBoxItem Content="15 min" Tag="15"/><ComboBoxItem Content="25 min" Tag="25"/><ComboBoxItem Content="45 min" Tag="45"/><ComboBoxItem Content="60 min" Tag="60"/></ComboBox></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0"><Button x:Name="StartTimerButton" Content="Start session" Click="StartTimer_Click" Background="#287A58" Foreground="White"/><Button x:Name="PauseTimerButton" Content="Pause" Click="PauseTimer_Click" IsEnabled="False"/><Button Content="Finish" Click="StopTimer_Click"/></StackPanel>
       </StackPanel></Border>
       <Border Background="White" CornerRadius="14" Padding="22"><StackPanel><TextBlock Text="Recent sessions" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/><ItemsControl x:Name="SessionList"/></StackPanel></Border>
      </StackPanel>
     </Grid>
     <Grid x:Name="BlockingPanel" Visibility="Collapsed">
      <StackPanel>
       <Border Background="White" CornerRadius="14" Padding="22" Margin="0,0,0,18"><StackPanel><TextBlock Text="Block distracting apps" FontSize="17" FontWeight="Bold"/><TextBlock Text="When a listed app becomes the active window, Guardian minimizes it. This is a gentle reminder, not tamper-proof parental control." TextWrapping="Wrap" Foreground="#75817B" FontSize="12" Margin="0,7,0,18"/><DockPanel><TextBox x:Name="BlockNameBox" MinWidth="220" ToolTip="Process name, e.g. Discord or chrome.exe"/><Button Content="Add app" Click="AddBlock_Click" Background="#287A58" Foreground="White" DockPanel.Dock="Right" Margin="10,0,0,0"/></DockPanel><TextBlock Text="Enter the process name (not a website URL). Rules are stored locally." FontSize="11" Foreground="#75817B" Margin="0,8,0,0"/><TextBlock x:Name="BlockErrorText" Visibility="Collapsed" Foreground="#B33A3A" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
       <Border Background="White" CornerRadius="14" Padding="22"><StackPanel><TextBlock Text="Your block list" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/><ItemsControl x:Name="BlockList"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,5"><TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="13"/><Button Content="Remove" Tag="{Binding}" Click="RemoveBlock_Click" DockPanel.Dock="Right" Padding="10,5"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoBlocksText" Text="No apps blocked. Add one above when you're ready." Foreground="#75817B"/></StackPanel></Border>
      </StackPanel>
     </Grid>
     <Grid x:Name="PrivacyPanel" Visibility="Collapsed">
      <StackPanel>
       <Border Background="White" CornerRadius="14" Padding="24" Margin="0,0,0,18"><StackPanel><TextBlock Text="Privacy &amp; preferences" FontSize="18" FontWeight="Bold"/><TextBlock Text="Guardian stores its small local database under your Windows LocalAppData folder. It does not send data to a server." TextWrapping="Wrap" Foreground="#75817B" Margin="0,8,0,18"/><CheckBox x:Name="MonitoringCheck" Content="Enable foreground application tracking" Checked="Monitoring_Changed" Unchecked="Monitoring_Changed"/><CheckBox x:Name="BlockingCheck" Content="Enable app blocking rules" Checked="Blocking_Changed" Unchecked="Blocking_Changed"/><TextBlock Text="No window titles, keystrokes, screenshots or browser contents are collected." Foreground="#287A58" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
       <Border Background="White" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="Reset local data" FontSize="16" FontWeight="Bold"/><TextBlock Text="Permanently deletes activity history and completed focus sessions. Your block list and preferences remain." Foreground="#75817B" TextWrapping="Wrap" Margin="0,6,0,14"/><Button Content="Delete activity history" Click="ClearHistory_Click" HorizontalAlignment="Left"/></StackPanel></Border>
      </StackPanel>
     </Grid>
    </Grid>
   </Grid>
  </ScrollViewer>
 </Grid>
</Window>
